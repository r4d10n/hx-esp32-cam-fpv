# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# CPU and SPIRAM
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y

# Cache optimization
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Camera module
CONFIG_CAMERA_MODULE_ESP_S3_EYE=y

# ESP-IDF tool config
CONFIG_ESPTOOLPY_NO_STUB=y

# Console on UART (not USB, to free USB for UVC)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM_0=y

# USB OTG peripheral enabled
CONFIG_SOC_USB_OTG_SUPPORTED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logging level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Disable brownout detector for stable USB
CONFIG_ESP_BROWNOUT_DET=n

# Watchdog disabled for debugging
CONFIG_ESP_TASK_WDT_EN=n
