menu "ESP32 FPV Ground Station Configuration"

    config FPV_GS_DEFAULT_CHANNEL
        int "Default WiFi channel"
        default 7
        range 1 14
        help
            Default WiFi channel for FPV reception and AP.

    config FPV_GS_DEFAULT_AP_SSID
        string "Default AP SSID"
        default "ESP32-FPV-GS"
        help
            Default SSID for the ground station access point.

    config FPV_GS_DEFAULT_AP_PASS
        string "Default AP Password"
        default "fpvground"
        help
            Default password for the ground station access point.
            Must be at least 8 characters.

    config FPV_GS_MAX_STA_CONN
        int "Maximum AP connections"
        default 2
        range 1 4
        help
            Maximum number of stations that can connect to the AP.

    config FPV_GS_FRAME_BUFFER_COUNT
        int "Frame buffer count"
        default 2
        range 2 5
        help
            Number of frame buffers in the ring buffer.
            Use 2 without PSRAM, 3-5 with PSRAM.

    config FPV_GS_MAX_FRAME_SIZE
        int "Maximum frame size (bytes)"
        default 49152
        range 16384 131072
        help
            Maximum size of a single JPEG frame.
            48KB balances frame size vs memory for WiFi crypto.
            Use 64KB+ with PSRAM.

    config FPV_GS_PACKET_QUEUE_SIZE
        int "Packet queue size"
        default 32
        range 16 64
        help
            Size of the packet processing queue.

    config FPV_GS_FEC_K
        int "FEC K value (data packets per block)"
        default 6
        range 1 12
        help
            Number of primary data packets per FEC block.

    config FPV_GS_FEC_N
        int "FEC N value (total packets per block)"
        default 12
        range 2 24
        help
            Total number of packets per FEC block (K data + N-K parity).

    menu "Network Interface Selection"

        config FPV_GS_ENABLE_USB_NET
            bool "Enable USB Network (NCM)"
            default n
            help
                Enable USB networking using NCM protocol.
                The device appears as a USB network adapter on the host PC.
                Default IP: 192.168.4.1 (configurable via usb-netif component).
                Requires USB-OTG port (not USB-Serial/JTAG).
                Note: USB Serial/JTAG must be disabled in sdkconfig.

        config FPV_GS_ENABLE_WIFI_AP
            bool "Enable WiFi Access Point"
            default y
            help
                Enable WiFi access point for wireless web interface access.
                Promiscuous packet capture is always enabled regardless.
                Disable to save memory when using USB-only mode.

    endmenu

    menu "USB UVC (USB Camera) Configuration"

        config FPV_GS_ENABLE_USB_UVC
            bool "Enable USB UVC (USB Webcam)"
            default y
            help
                Enable USB Video Class (UVC) device mode.
                The ESP32-S3 appears as a USB webcam to the host PC/Android.
                Can be used with standard camera apps (VLC, OBS, etc.).
                Runtime switching between UVC and NCM modes is supported.

        config FPV_GS_UVC_WIDTH
            int "UVC Frame Width"
            default 640
            range 320 1280
            depends on FPV_GS_ENABLE_USB_UVC
            help
                Default width for UVC video frames.
                Common values: 320, 480, 640, 800, 1280
                Higher resolutions require more bandwidth.

        config FPV_GS_UVC_HEIGHT
            int "UVC Frame Height"
            default 480
            range 240 720
            depends on FPV_GS_ENABLE_USB_UVC
            help
                Default height for UVC video frames.
                Common values: 240, 320, 360, 456, 480, 720
                Higher resolutions require more bandwidth.

        config FPV_GS_UVC_FPS
            int "UVC Frame Rate"
            default 15
            range 5 30
            depends on FPV_GS_ENABLE_USB_UVC
            help
                Target frame rate for UVC streaming.
                Actual FPS depends on incoming video and USB bandwidth.
                15 FPS is recommended for 640x480.

        config FPV_GS_UVC_BULK_MODE
            bool "Use Bulk Transfer Mode (experimental)"
            default n
            depends on FPV_GS_ENABLE_USB_UVC
            help
                Use bulk transfer instead of isochronous for UVC.
                Bulk mode offers higher throughput (~1.2 MB/s vs ~512 KB/s)
                but may have compatibility issues on some Linux systems.
                Default (isochronous) is recommended for better compatibility.

                IMPORTANT: This option alone is not sufficient. You must also set
                CONFIG_UVC_CAM1_XFER_MODE=1 in sdkconfig.defaults for bulk mode.
                Use the provided sdkconfig.defaults.bulk file for bulk mode builds:
                  cp sdkconfig.defaults.bulk sdkconfig.defaults && idf.py build

        config FPV_GS_UVC_DEFAULT_ACTIVE
            bool "UVC active by default (NCM inactive)"
            default n
            depends on FPV_GS_ENABLE_USB_UVC && FPV_GS_ENABLE_USB_NET
            help
                If both UVC and NCM are enabled, this selects which one
                is active by default at boot. Can be switched at runtime.
                If disabled, NCM is active by default.

    endmenu

endmenu
